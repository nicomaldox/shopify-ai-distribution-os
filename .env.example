# ==============================================================================
# Shopify AI Distribution OS — Environment Variables Example
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit the .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
API_BASE_URL=http://localhost:8080
REDIRECT_BASE_URL=http://localhost:8080
CREATOR_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
DEFAULT_CURRENCY=TWD
DEFAULT_LOCALE=en

# ------------------------------------------------------------------------------
# Shopify Store Integration (Admin GraphQL API 2026-07)
# ------------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07

# ------------------------------------------------------------------------------
# Primary Database (PostgreSQL 16+)
# ------------------------------------------------------------------------------
POSTGRES_USER=distribution_user
POSTGRES_PASSWORD=distribution_password
POSTGRES_DB=distribution_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://distribution_user:distribution_password@localhost:5432/distribution_db

# ------------------------------------------------------------------------------
# Cache & Idempotency Store (Valkey / Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI Content Generation Engine (OpenAI API & LangSmith Tracing)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_LLM_MODEL=gpt-4o
OPENAI_TTS_VOICE=alloy

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=shopify-ai-os-poc

# ------------------------------------------------------------------------------
# AI Video Generation Worker (Cloud API - Fal.ai / Replicate)
# ------------------------------------------------------------------------------
FAL_KEY=fal_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Security & Session Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production
SESSION_SALT=session_salt_hash_key_change_me
DEFAULT_COMMISSION_PERCENTAGE=20.00
COMMISSION_HOLD_DAYS=7
